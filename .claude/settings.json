{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/validate_mapa.py",
            "timeout": 60,
            "statusMessage": "Validando mapa.json..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/validate_questoes.py",
            "timeout": 60,
            "statusMessage": "Validando questoes.jsonl..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/pre_push_eval.py",
            "timeout": 180,
            "statusMessage": "Rodando eval harness antes do push..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/auto_commit.py",
            "timeout": 120,
            "statusMessage": "Auto-commit & push..."
          }
        ]
      }
    ]
  }
}